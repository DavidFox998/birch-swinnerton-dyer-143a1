  b₄ = a₁a₃ + 2a₄            =  −2
  b₆ = a₃² + 4a₆             =  −7
  b₈ = a₁²a₆ − a₁a₃a₄ + 4a₂a₆ + a₂a₃² − a₄²  =  6
