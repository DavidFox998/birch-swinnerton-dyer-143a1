theorem BSD_generator_on_curve :
    let x : ℚ := 2; let y : ℚ := 0
    y ^ 2 + y = x ^ 3 - x ^ 2 - x - 2 := by norm_num

/-- **PROVED** (unconditional): a_n(1) = 1.
